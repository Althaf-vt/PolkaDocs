# Runtime mode
NODE_ENV=development

# API port
PORT=3000

# Postgres connection
DATABASE_URL=postgres://PolkaDocs:<password>@localhost:5432/PolkaDocs

# Access token signing
JWT_ACCESS_SECRET=<random 32+ chars>

# Refresh token signing
JWT_REFRESH_SECRET=<random 32+ chars>

# Access token lifetime
JWT_ACCESS_TTL=15m

# Refresh token lifetime
JWT_REFRESH_TTL=7d

# Gemini access
GEMINI_API_KEY=<your key>

# Which adapters are bound (gemini or langchain)
AI_PROVIDER=gemini

# Generation model
CHAT_MODEL=<gemini chat model>

# Embedding model
EMBEDDING_MODEL=<gemini embedding model>

# Must match vector(N)
EMBEDDING_DIMENSIONS=768

# Chunk size in characters
CHUNK_SIZE=900

# Overlap in characters
CHUNK_OVERLAP=120

# Chunks retrieved per question
RETRIEVAL_TOP_K=5

# Relevance threshold
RETRIEVAL_MIN_SCORE=<tuned>

# Upload size limit
MAX_UPLOAD_MB=10

# Where uploaded files are kept
FILE_STORAGE_PATH=./storage

# Allowed frontend origin
CORS_ORIGIN=http://localhost:5173

